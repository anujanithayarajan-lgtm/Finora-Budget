{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "finora-budget-api": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "finora-budget-api" } },
    { "source": "/transactions", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
